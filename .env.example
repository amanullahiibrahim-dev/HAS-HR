# Copy to .env.local on the server. Never commit the real .env.local.
HAAZIR_ADMIN_PASSWORD=change-this-to-a-long-unique-password
HAAZIR_SESSION_SECRET=replace-with-at-least-32-random-characters
ZKTECO_DEVICE_SN=replace-with-the-iClock990-serial-number
ZKTECO_DEVICE_IP=replace-with-the-terminal-fixed-private-ip
# Set one specific private IP belonging to the office server.
# The server refuses wildcard addresses and public addresses.
HAAZIR_BIND_HOST=127.0.0.1
# Optional attendance-software bridge token; use at least 32 random characters.
# Keep unset until the office connector is ready. Never put this token in browser code.
# HAAZIR_SYNC_TOKEN=replace-with-a-random-bridge-only-token
# Optional absolute path on a persistent office-server disk:
# HAAZIR_DB_PATH=D:/Haazir/data/haazir-data.json

# Direct LAN pull connector (no ADMS change needed):
# ZKTECO_DEVICE_IP and ZKTECO_DEVICE_SN above must be the actual terminal values.
ZKTECO_DEVICE_PORT=4370
ZKTECO_COMM_KEY=0
ZKTECO_TIMEOUT_MS=10000
ZKTECO_UDP_PORT=4000
ZKTECO_POLL_SECONDS=60
# Same computer as Haazir; change the port if your app uses another port.
HAAZIR_SYNC_URL=http://127.0.0.1:3000/api/integrations/attendance

# Optional private persistent directory for MC attachments (never public/):
# HAAZIR_MC_DIRECTORY=D:/Haazir/private/mc-documents

# Gmail password recovery. Set real values only in the private server .env.local.
# HAAZIR_RECOVERY_EMAIL=administrator@gmail.com
# HAAZIR_GMAIL_USER=sender@gmail.com
# HAAZIR_GMAIL_APP_PASSWORD=your-16-character-google-app-password
